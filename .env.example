# Firebase AI Logic — web (Chrome), Gemini Nano hybrid inference
# Create a Firebase project, register a web app, then enable:
#   Authentication (Google + Email/Password), Firestore, Remote Config, App Check, AI Logic
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check (reCAPTCHA Enterprise) — required by Firebase AI Logic
VITE_RECAPTCHA_SITE_KEY=
# Register this debug token in Firebase console > App Check > Apps > Manage debug tokens
VITE_APP_CHECK_DEBUG_TOKEN=8F2A-91CD-4E77-DEBUG
